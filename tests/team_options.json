{
  "option": {
    "ExpTeam": {
      "type": "select",
      "label": "$ExpTeam",
      "description": "$ExpTeam_description",
      "default_case": "none",
      "cases": [
        {
          "name": "none",
          "label": "$ExpTeam_none"
        },
        {
          "name": "a",
          "label": "Team a（TEAMS #1）",
          "pipeline_override": {
            "ExpLuxcavation": {
              "attach": {
                "team": "a"
              }
            }
          }
        },
        {
          "name": "b",
          "label": "Team b（TEAMS #2）",
          "pipeline_override": {
            "ExpLuxcavation": {
              "attach": {
                "team": "b"
              }
            }
          }
        },
        {
          "name": "gone",
          "label": "Team gone（TEAMS #5）（已刪除）",
          "pipeline_override": {
            "ExpLuxcavation": {
              "attach": {
                "team": "gone"
              }
            }
          }
        }
      ]
    },
    "ThreadTeam": {
      "type": "select",
      "label": "$ThreadTeam",
      "description": "$ThreadTeam_description",
      "default_case": "none",
      "cases": [
        {
          "name": "none",
          "label": "$ThreadTeam_none"
        },
        {
          "name": "a",
          "label": "Team a（TEAMS #1）",
          "pipeline_override": {
            "ThreadLuxcavation": {
              "attach": {
                "team": "a"
              }
            }
          }
        },
        {
          "name": "b",
          "label": "Team b（TEAMS #2）",
          "pipeline_override": {
            "ThreadLuxcavation": {
              "attach": {
                "team": "b"
              }
            }
          }
        },
        {
          "name": "gone",
          "label": "Team gone（TEAMS #5）（已刪除）",
          "pipeline_override": {
            "ThreadLuxcavation": {
              "attach": {
                "team": "gone"
              }
            }
          }
        }
      ]
    }
  }
}

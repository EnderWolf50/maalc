    {"name": "repeated gift search gift", "edits": [{"set": "teams/1/gift_search/gifts/-", "value": {"keyword": "Bleed", "tier": 3, "name": "Smokes and Wires"}}], "schema": ["teams/1/gift_search/gifts"]},
    {"name": "a vestige may be kept by name, tier IV too", "edits": [{"set": "teams/0/keep_gifts/-", "value": {"keyword": "Keywordless", "tier": 4, "name": "Brilliant Vestige"}}], "cross": []},

       "teams/0/starlight: team 'Team a' uses missing plan 'gone' (not in starlight_plans)",
       "teams/1/theme_pack_plan: team 'Team b' uses missing plan 'gone' (not in theme_pack_plans)"]},
    {"name": "duplicate team id", "edits": [{"set": "teams/1/id", "value": "a"}], "cross": ["teams: id 'a' appears 2 times"]},
    {"name": "duplicate plan id and name with quotes", "edits": [
       {"set": "deployment_order_plans/0/name", "value": "Don't"},
       {"set": "deployment_order_plans/-", "value": {"id": "d1", "name": "Don't", "order": ["Yi Sang", "Faust", "Don Quixote", "Ryōshū", "Meursault", "Hong Lu", "Heathcliff", "Ishmael", "Rodion", "Sinclair", "Outis", "Gregor"]}}],
     "cross": ["deployment_order_plans: id 'd1' appears 2 times", "deployment_order_plans: name \"Don't\" appears 2 times"]},
    {"name": "more than 3 gifts to search", "edits": [
       {"set": "teams/0/gift_search/gifts", "value": [

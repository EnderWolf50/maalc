    {"name": "bad custom starlight level", "edits": [{"set": "teams/1/starlight/custom/levels/0", "value": "max"}], "schema": ["teams/1/starlight"]},
    {"name": "theme pack weight out of range", "edits": [{"set": "theme_pack_plans/0/weights/X", "value": 11}], "schema": ["theme_pack_plans/0/weights/X"]},
    {"name": "theme pack weight not a whole number", "edits": [{"set": "theme_pack_plans/0/weights/X", "value": 1.5}], "schema": ["theme_pack_plans/0/weights/X"]},
    {"name": "theme pack threshold and unlisted out of range", "edits": [{"set": "theme_pack_plans/0/threshold", "value": -11}, {"set": "theme_pack_plans/0/unlisted", "value": 12}], "schema": ["theme_pack_plans/0/threshold", "theme_pack_plans/0/unlisted"]},
    {"name": "bad event pack mode", "edits": [{"set": "theme_pack_plans/0/event_packs", "value": "skip"}], "schema": ["theme_pack_plans/0/event_packs"]},
    {"name": "the old marks are gone", "edits": [{"set": "theme_pack_plans/0/marks", "value": {}}], "schema": ["theme_pack_plans/0"]},
    {"name": "user plan named default", "edits": [{"set": "theme_pack_plans/0/id", "value": "default"}], "schema": ["theme_pack_plans/0/id"]},
    {"name": "missing team field", "edits": [{"delete": "teams/0/heal"}], "schema": ["teams/0"]},

         {"keyword": "Bleed", "tier": 2, "name": "C"}, {"keyword": "Bleed", "tier": 1, "name": "D"}]}],
     "schema": ["teams/0/gift_search/gifts"]},
    {"name": "duplicate overrides", "edits": [
       {"set": "event_overrides/-", "value": {"question": "Q?", "option": "No"}},
       {"set": "trial_risk_overrides/-", "value": {"trial": "Growth I", "risk": 1}},
       {"set": "trial_risk_overrides/-", "value": {"trial": "Growth I", "risk": 2}}],

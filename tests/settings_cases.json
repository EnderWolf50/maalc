    {"name": "empty override question", "edits": [{"set": "event_overrides/0/question", "value": ""}], "schema": ["event_overrides/0/question"]},
    {"name": "no enabled team: only MirrorDungeon asks for one (#364)", "edits": [{"set": "teams/0/enabled", "value": false}, {"set": "teams/1/enabled", "value": false}],
     "cross": []},
    {"name": "no team at all", "edits": [{"set": "teams", "value": []}], "cross": []},
    {"name": "two enabled teams on one slot", "edits": [{"set": "teams/1/game_team", "value": 1}],

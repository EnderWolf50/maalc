{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maalc-settings",
  "version": "2.0.3",
  "identifier": "tw.enderwolf.maalc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "maalc", "width": 1500, "height": 860, "minWidth": 800, "minHeight": 480, "dragDropEnabled": false,
      "decorations": false, "center": true, "preventOverflow": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-root-dir",
    "allow-load-settings",
    "allow-load-game-data",
    "allow-save-settings",
    "allow-save-old-settings",
    "allow-load-read-back",
    "allow-append-runs-log",
    "allow-start-run",
    "allow-stop-run",
    "allow-attach-run",
    "allow-scan-devices",
    "allow-hide-to-tray",
    "allow-check-update",
    "allow-last-update",
    "allow-download-update",
    "allow-apply-update"
  ]
}

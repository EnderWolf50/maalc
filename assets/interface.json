{
    "$schema": "https://raw.githubusercontent.com/MaaXYZ/MaaFramework/main/tools/interface.schema.json",
    "interface_version": 2,
    "languages": {
        "zh_tw": "locales/zh_tw.json",
        "en_us": "locales/en_us.json"
    },
    "name": "maalc",
    "label": "$maalc",
    "github": "https://github.com/EnderWolf50/maalc",
    "version": "v0.0.0",
    "license": "PolyForm-Noncommercial-1.0.0",
    "controller": [
        {
            "name": "MuMu",
            "label": "$MuMu",
            "type": "Adb",
            // PI V2 has no adb screencap/input fields: the client uses whatever
            // Toolkit.find_adb_devices() reports. Any method that connects and taps works.
            "adb": {}
        }
    ],
    "resource": [
        {
            "name": "base",
            "label": "$base",
            "path": [
                "./resource/base"
            ]
        }
    ],
    "agent": {
        // tools/install.py pins this to an absolute interpreter path, or to the bundled ./python/python.exe with --release.
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "MirrorDungeon",
            "label": "$MirrorDungeon",
            "entry": "MirrorDungeon"
        },
        {
            "name": "AssembleModules",
            "label": "$AssembleModules",
            "entry": "AssembleModules"
        },
        {
            "name": "ClaimMail",
            "label": "$ClaimMail",
            "entry": "ClaimMail"
        },
        {
            "name": "ExpLuxcavation",
            "label": "$ExpLuxcavation",
            "entry": "ExpLuxcavation"
        },
        {
            "name": "ClaimPassMissions",
            "label": "$ClaimPassMissions",
            "entry": "ClaimPassMissions"
        },
        // Temporary, for verifying GoHome (#365); the daily tasks run it themselves.
        {
            "name": "GoHome",
            "label": "$GoHome",
            "entry": "GoHome"
        }
    ]
}

{
    // EXP Luxcavation (#366): ExpStart picks the team (luxcavation.exp), then the daily task entry of spec 01: GoHome run
    // by GoHomeRun, and ExpHub, which plays the rightmost open stage of the EXP tab once; its last step runs GoHome again.
    "ExpLuxcavation": {
        "action": "Custom",
        "custom_action": "ExpStart",
        "next": [
            "ExpHome"
        ]
    },
    "ExpHome": {
        "action": "Custom",
        "custom_action": "ExpHome",
        "next": [
            "ExpHub"
        ]
    },
    // The pages after To Battle! (level warning, start confirm, results) have no capture yet (#366): their screens time
    // out here and the task stops with evidence, a failure the client's list goes past. Stuck (the watchdog: the same
    // screen over and over) stops it too: no recovery ladder on the daily pages yet.
    "ExpHub": {
        "timeout": 60000,
        "rate_limit": 300,
        "on_error": [
            "ExpLost"
        ],
        "next": [
            "ExpStuck",
            "TaskDone",
            "[JumpBack]BattleHUD",
            "[JumpBack]Connecting",
            "[JumpBack]HelpPager",
            "[JumpBack]ExpText",
            "[JumpBack]LuxTeamSelect",
            "[JumpBack]LuxExpEnter",
            "[JumpBack]LuxExpTab",
            "[JumpBack]NavLuxcavation",
            "[JumpBack]NavTitle",
            "[JumpBack]NavMainTabs"
        ]
    },
    "ExpLost": {
        "action": "Custom",
        "custom_action": "StopTask",
        "custom_action_param": "EXP Luxcavation: no screen known for 60 s"
    },
    "ExpStuck": {
        "recognition": "Custom",
        "custom_recognition": "StuckFlag",
        "action": "Custom",
        "custom_action": "StopTask",
        "custom_action_param": "EXP Luxcavation is stuck"
    },
    // ExpHub's OCR screens, read in one pass as HubText (#157): GoHome's popups (HomeText), then the battle's end.
    "ExpText": {
        "recognition": "Custom",
        "custom_recognition": "HubText",
        "custom_recognition_param": {
            "base": "HomeText",
            "entries": [
                "Victory"
            ],
            "tail": []
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 300,
        "timeout": 0,
        "on_error": [
            "ExpTextLost"
        ]
    },
    "ExpTextLost": {
        "pre_delay": 0,
        "post_delay": 0
    },
    // Enter opens the mirror's team page (tests/screens/LuxTeamSelect.png, TeamSelect.png): the TEAMS list at the left,
    // the same rows and taps (pick_team_slot), but To Battle! at the bottom right where the mirror's has Confirm.
    // Shared by the Luxcavation hubs (EXP, Thread): each lists it and sets RUN["team"] first.
    "LuxTeamSelect": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "sub_name": "LuxTeamsHeader",
                "roi": [80, 272, 100, 28],
                "expected": "^TEAMS$"
            },
            {
                "recognition": "OCR",
                "sub_name": "LuxToBattle",
                "roi": [1075, 570, 140, 38],
                "expected": "To Battle"
            }
        ],
        "action": "Custom",
        "custom_action": "LuxSelectTeam",
        "post_delay": 0
    },
    // The Enkephalin Module icon in the bottom-left panel (the round one; the card icon left of it is the Boxes). The panel
    // sits at x 393 on the main window and Drive, at x 242 on the Luxcavation pages (0.95 there, 1.0 on the main window),
    // so the icon is found and the number read to its right (actions.module_count).
    "ModuleIcon": {
        "recognition": "TemplateMatch",
        "roi": [150, 615, 330, 55],
        "template": "Luxcavation/ModuleIcon.png",
        "threshold": 0.8
    },
    // Drive's Luxcavation button (tests/screens/Drive.png).
    "NavLuxcavation": {
        "recognition": "TemplateMatch",
        "roi": [340, 80, 240, 160],
        "template": "Navigation/NavLuxcavation.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 2000
    },
    // A Luxcavation tab is lit by an orange frame: ~1060 orange px in its roi, no other screen over 710
    // (tests/screens/LuxExp.png, LuxThread.png). The unlit and lit tabs read the same to a template (0.93).
    "LuxExpLit": {
        "recognition": "ColorMatch",
        "roi": [62, 228, 166, 72],
        "lower": [200, 120, 0],
        "upper": [255, 200, 80],
        "count": 900
    },
    // The Thread tab lit (LuxThread.png) under the Luxcavation panel: tap EXP.
    "LuxExpTab": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "TemplateMatch",
                "sub_name": "LuxPanel",
                "roi": [55, 170, 180, 60],
                "template": "Luxcavation/LuxPanel.png",
                "threshold": 0.8
            },
            {
                "recognition": "ColorMatch",
                "sub_name": "LuxThreadLit",
                "roi": [62, 297, 166, 72],
                "lower": [200, 120, 0],
                "upper": [255, 200, 80],
                "count": 900
            }
        ],
        "action": "Click",
        "target": [70, 236, 150, 56],
        "post_delay": 1500
    },
    // The EXP tab as it opens shows its three hardest stages (2026-10-26: 7-9 of 10, the 10th locked, KEEP OUT, with no
    // Enter): the rightmost Enter is the hardest open stage. The box is that Enter's (index -1: the last, left to right).
    "LuxExpEnter": {
        "recognition": "And",
        "all_of": [
            "LuxExpLit",
            {
                "recognition": "TemplateMatch",
                "sub_name": "LuxExpEnterButton",
                "roi": [290, 450, 960, 60],
                "template": "Luxcavation/LuxExpEnter.png",
                "threshold": 0.8,
                "order_by": "Horizontal",
                "index": -1
            }
        ],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "ExpEnter",
        "pre_delay": 500,
        "post_delay": 0
    },
    // Thread Luxcavation (#368): ThreadStart picks the team (luxcavation.thread), then the same entry as EXP (GoHomeRun
    // through ThreadHome) and ThreadHub, which plays the hardest level of today's one open card of the Thread tab, over
    // and over until `count` are won. Its screens: the Thread tab's open card (Enter), its Level Select (the bottom row's
    // Enter), then the pages EXP's Enter leads to as well (ExpHub's list: the team page, the battle, the results).
    "ThreadLuxcavation": {
        "action": "Custom",
        "custom_action": "ThreadStart",
        "next": [
            "ThreadHome"
        ]
    },
    "ThreadHome": {
        "action": "Custom",
        "custom_action": "ThreadHome",
        "next": [
            "ThreadHub"
        ]
    },
    // ExpText is the one pass over the OCR screens of both hubs. The team page after Level Select has no node here yet:
    // it waits for #366's, which both hubs list (#366b).
    "ThreadHub": {
        "timeout": 60000,
        "rate_limit": 300,
        "on_error": [
            "ThreadLost"
        ],
        "next": [
            "ThreadStuck",
            "TaskDone",
            "[JumpBack]BattleHUD",
            "[JumpBack]Connecting",
            "[JumpBack]HelpPager",
            "[JumpBack]ExpText",
            "[JumpBack]LuxTeamSelect",
            "[JumpBack]LuxThreadLevel",
            "[JumpBack]LuxThreadEnter",
            "[JumpBack]LuxThreadSwipe",
            "[JumpBack]LuxThreadTab",
            "[JumpBack]NavLuxcavation",
            "[JumpBack]NavTitle",
            "[JumpBack]NavMainTabs"
        ]
    },
    "ThreadLost": {
        "action": "Custom",
        "custom_action": "StopTask",
        "custom_action_param": "Thread Luxcavation: no screen known for 60 s"
    },
    "ThreadStuck": {
        "recognition": "Custom",
        "custom_recognition": "StuckFlag",
        "action": "Custom",
        "custom_action": "StopTask",
        "custom_action_param": "Thread Luxcavation is stuck"
    },
    // The Thread tab lit: its orange frame, as the EXP tab's (LuxExpLit).
    "LuxThreadLit": {
        "recognition": "ColorMatch",
        "roi": [62, 297, 166, 72],
        "lower": [200, 120, 0],
        "upper": [255, 200, 80],
        "count": 900
    },
    // Luxcavation on its EXP tab (the tab it opens on): tap Thread.
    "LuxThreadTab": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "TemplateMatch",
                "sub_name": "LuxPanel",
                "roi": [55, 170, 180, 60],
                "template": "Luxcavation/LuxPanel.png",
                "threshold": 0.8
            },
            "LuxExpLit"
        ],
        "action": "Click",
        "target": [70, 306, 150, 56],
        "post_delay": 1500
    },
    // The Thread tab shows four of the seven cards; the open one has a lit Enter (tests/screens/LuxThread.png, LuxThreadLust.png:
    // the cards that open on other days read 0.6 at most). The list starts at today's card, but it keeps where it was
    // scrolled, so a tab that shows none was left scrolled away (LuxThreadScrolled.png): swipe to the right, which brings
    // the left cards in (unverified, the direction of the game's drag).
    "LuxThreadEnter": {
        "recognition": "And",
        "all_of": [
            "LuxThreadLit",
            {
                "recognition": "TemplateMatch",
                "sub_name": "LuxThreadEnterButton",
                "roi": [255, 455, 1000, 50],
                "template": "Luxcavation/LuxThreadEnter.png",
                "threshold": 0.9
            }
        ],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "ThreadEnter",
        "pre_delay": 500,
        "post_delay": 0
    },
    // The Thread tab with nothing else known: it comes after LuxThreadEnter in the hub, so it is the tab with no open card on
    // show. (An inverted match of the Enter in this And never hit.)
    "LuxThreadSwipe": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "TemplateMatch",
                "sub_name": "LuxPanel",
                "roi": [55, 170, 180, 60],
                "template": "Luxcavation/LuxPanel.png",
                "threshold": 0.8
            },
            "LuxThreadLit"
        ],
        "action": "Swipe",
        "begin": [330, 330, 40, 20],
        "end": [1100, 330, 40, 20],
        "duration": 600,
        "post_delay": 1000,
        "max_hit": 4
    },
    // The card's Level Select: a list of levels, each with its own Enter and -2 Modules, that opens at its bottom row, the
    // hardest (Lv60 of Lust; tests/screens/LuxThreadLevels.png). The box is the lowest Enter on show.
    "LuxThreadLevel": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "TemplateMatch",
                "sub_name": "LuxLevelSelect",
                "roi": [480, 90, 320, 65],
                "template": "Luxcavation/LuxLevelSelect.png",
                "threshold": 0.9
            },
            {
                "recognition": "TemplateMatch",
                "sub_name": "LuxLevelEnterButton",
                "roi": [700, 225, 260, 330],
                "template": "Luxcavation/LuxLevelEnter.png",
                "threshold": 0.9,
                "order_by": "Vertical",
                "index": -1
            }
        ],
        "box_index": 1,
        "action": "Custom",
        "custom_action": "ThreadLevel",
        "pre_delay": 500,
        "post_delay": 0
    }
}

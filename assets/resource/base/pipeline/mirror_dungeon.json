    },
    // Entry page: branch on the Exploring: field (spec 01, 入口頁的分流).
    "MirrorEntryNewRun": {
        "recognition": "OCR",
        "roi": [990, 140, 230, 35],
        "expected": "Before Entry",
        "action": "Custom",
        "custom_action": "PlanRun"
    },
    // Tracer: a paused run or an unclaimed reward stops the task instead of
    // resuming or settling it: Resume lands with #31, settlement with #30.
    "MirrorEntryPaused": {
        "recognition": "OCR",
        "roi": [990, 140, 230, 35],
        "expected": "F\\s*\\d",
        "action": "Custom",
        "custom_action": "Halt",
        "custom_action_param": "paused run on the entry page, not resuming"
    },
    "MirrorEntryUnclaimed": {
        "recognition": "OCR",
        "roi": [990, 140, 230, 35],
        "expected": "Exploration Complete",
        "action": "Custom",
        "custom_action": "Halt",
        "custom_action_param": "unclaimed rewards on the entry page, not claiming"
    },
    // Pops up by itself on the entry page while rewards are pending (captures/253).

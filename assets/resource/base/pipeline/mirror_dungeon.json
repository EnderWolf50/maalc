        "timeout": 60000,
        "next": [
            "[JumpBack]Connecting",
            "[JumpBack]RetryPopup",
            "MaintenanceNotice",
            "[JumpBack]Loading",
            "ExplorationReward",
            "[JumpBack]DefeatScreen",
            "[JumpBack]ExplorationComplete",
            "[JumpBack]MirrorEnterDialog",
            "MirrorEntryUnclaimed",
            "MirrorEntryPaused",
            "[JumpBack]MirrorEntryNewRun",
            "[JumpBack]LevelWarning",
            "[JumpBack]TeamSelect",
            "[JumpBack]StarlightConfirm",
            "[JumpBack]StarlightPage",
            "[JumpBack]GiftGet",
            "[JumpBack]GiftSearchForgo",
            "[JumpBack]GiftSearch",
            "[JumpBack]StartingGift",
            "[JumpBack]ThemePack",
            "[JumpBack]RewardCardForgo",
            "[JumpBack]GiftRefuseDialog",
            "[JumpBack]RewardCard",
            "[JumpBack]GiftChoice",
            "[JumpBack]Event",
            "[JumpBack]WipeDialog",
            "[JumpBack]Victory",
            "[JumpBack]Formation",
            "[JumpBack]BattleTurn",

    // Waiting for input: the Win Rate label, off or on. It moves half a slot (~40 px) right with every
    // extra skill slot: x 984 with 7 slots, ~740 with 1 (a 1-sinner formation, live 2026-10-16).
    "BattleTurn": {
        "recognition": "TemplateMatch",
        "roi": [700, 515, 580, 60],
        "template": [
            "Battle/BattleTurn.png",
            "Battle/BattleTurnPressed.png"
        ],
        "threshold": 0.8,
        "action": "Custom",
        "custom_action": "PlayTurn"
    },
    // A turn playing out: the pause button replaces the top-right controls.
    "BattlePause": {
        "recognition": "TemplateMatch",
        "roi": [1130, 5, 100, 75],
        "template": "Battle/BattlePause.png",
        "threshold": 0.8,
        "pre_delay": 0,
        "post_delay": 500
    },
    // The START plaque over the disc: every slot has a skill (#145). The agent sets the roi from the disc.
    "BattleStart": {
        "recognition": "TemplateMatch",
        "roi": [870, 480, 140, 60],
        "template": "Battle/BattleStart.png",
        "threshold": 0.5

{
    "MirrorDungeon": {
        "next": [
            "MirrorHub"
        ]
    },
    // Dispatch: every screen is one node; [JumpBack] nodes return here to look again.
    // next order is priority: Stuck (the watchdog, which must see every pass), global popups,
    // then dialogs before the page under them.
    // The OCR screens sit in HubText, never in this list, where MaaFramework would batch them (#157); BattleHUD, two
    // templates, comes before it: a battle screen needs no OCR pass over its skill text.
    // rate_limit: a pass is ~0.05-0.5 s of work; the default 1000 ms between passes saw every new screen ~0.5 s late.
    "MirrorHub": {
        "timeout": 60000,
        "rate_limit": 300,
        "on_error": [
            "GlobalStuck"
        ],
        "next": [
            "Stuck",
            "[JumpBack]BattleHUD",
            "[JumpBack]Connecting",
            "[JumpBack]HubText",
            "[JumpBack]MapNodePanel",
            "[JumpBack]MirrorMap",
            "[JumpBack]GoToMirrorEntry"
        ]
    },
    // MirrorHub's OCR screens, in priority order (#157): one OCR pass the Agent judges (agent/hub_text.py), then the
    // screens that may be up, each with its own OCR. In MirrorHub's next list MaaFramework would batch them, and the
    // batch re-reads every text box crossing a roi edge: a battle skill text 1 px into a dialog roi became a 443 x 1
    // read padded to 21264 px wide, 7.6 s and the Tasker from 4 to 12 GB for good. Each entry ends back in MirrorHub.
    "HubText": {
        "recognition": "Custom",
        "custom_recognition": "HubText",
        "custom_recognition_param": {
            "entries": [
                "RetryPopup",
                "MaintenanceNotice",
                "DownloadDialog",
                "Loading",
                "ClaimPopup",
                "ParallelModePrompt",
                "PopupButton",
                "ExplorationReward",
                "RunVictory",
                "DefeatScreen",
                "ExplorationComplete",
                "MirrorEnterDialog",
                "ResumeDialog",
                "ParallelModeOn",
                "MirrorEntryUnclaimed",
                "MirrorEntryPaused",
                "MirrorEntryNewRun",
                "LevelWarning",
                "TeamSelect",
                "StarlightConfirm",
                "StarlightPage",
                "GiftGet",
                "GiftSearchForgo",
                "GiftSearch",
                "StartingGift",
                "ThemePack",
                "RewardCardForgo",
                "GiftRefuseDialog",
                "RewardCard",
                "GiftChoice",
                "Shop",
                "Event",
                "WipeDialog",
                "Victory",
                "Formation",
                "ProgressPanel"
            ],
            "tail": [
                "MapNodePanel",
                "MirrorMap",
                "GoToMirrorEntry"
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 300,
        // Its picks look once or twice: a screen gone by then (the last loading screen) goes back to MirrorHub, which
        // reads the next one (#115: 1 s here held the theme pack page up 1.7 s).
        "timeout": 400,
        "on_error": [
            "HubTextLost"
        ]
    },
    // None of the screens HubText saw is up any more: back to MirrorHub (the jump back).
    "HubTextLost": {
        "pre_delay": 0,
        "post_delay": 0
    },
    // A battle screen (#157): the turn or the pause, without HubText's OCR pass over the skill text. The server's
    // popups, which can come up mid-battle, still come before the turn here, each behind a template (popups.json), so
    // a battle round reads no text (one OCR each, ~130 ms a round in the live A/B before the gates).
    "BattleHUD": {
        "recognition": "Or",
        "any_of": [
            "BattleTurn",
            "BattlePause"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 300,
        "timeout": 3000,
        "on_error": [
            "BattleHUDLost"
        ],
        "next": [
            "NoBatchOCR",
            "Connecting",
            "RetryPopup",
            "PopupButton",
            "BattleTurn",
            "BattlePause"
        ]
    },
    // The HUD went before its list saw anything: back to MirrorHub (the jump back), not the task's end.
    "BattleHUDLost": {},
    // Keeps MaaFramework from batching a next list's OCR (#157). The batch takes the model of the list's first OCR
    // and leaves out the others (PipelineTask::try_add_ocr_node), so this node's model, which no other OCR uses,
    // leaves a batch of one: none. Never hits; the 1 x 1 ColorMatch fails before the OCR, so the model is never
    // loaded.
    "NoBatchOCR": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "ColorMatch",
                "sub_name": "NoBatchOCRGate",
                "roi": [0, 0, 1, 1],
                "lower": [0, 0, 0],
                "upper": [255, 255, 255],
                "count": 2
            },
            {
                "recognition": "OCR",
                "sub_name": "NoBatchOCRModel",
                "model": "no-batch"
            }
        ]
    },
    // Entry page with Parallel Superposition Mode ON (#94): switched OFF before anything else, the bot never plays
    // past floor 5. Texts: EN_MirrorDungeonUI_5_InfinityFloor ("Parallel Superposition Mode : " + ON / OFF).
    // Its dialogs (Resume, Enter) come first in the hub: the label reads through them.
    "ParallelModeOn": {
        "recognition": "OCR",
        "roi": [890, 330, 330, 28],
        "expected": "Superposition.*:\\s*[O0]N\\b",
        "action": "Custom",
        "custom_action": "ParallelModeOff"
    },
    // Entry page: branch on the Exploring: field (spec 01, 入口頁的分流).
    "MirrorEntryNewRun": {
        "recognition": "OCR",
        "roi": [990, 140, 230, 35],
        "expected": "Before Entry",
        "action": "Custom",
        "custom_action": "PlanRun",
        "post_delay": 0
    },
    // A paused run (after To Window, a restart, or by hand): Enter opens the Resume dialog.
    "MirrorEntryPaused": {
        "recognition": "OCR",
        "roi": [990, 140, 230, 35],
        "expected": "F\\s*\\d",
        "action": "Custom",
        "custom_action": "TapUntil",
        "post_delay": 0,
        "custom_action_param": {
            "target": [1030, 470, 160, 50],
            "next": [
                {"roi": [80, 272, 100, 28], "expected": "^TEAMS$"},
                {"roi": [520, 380, 240, 40], "expected": "^Resume$"}
            ],
            "timeout": 4
        }
    },
    // Dungeon Progress with Resume / Halt Exploration / Cancel: always Resume (spec 01 入口頁的分流).
    "ResumeDialog": {
        "recognition": "OCR",
        "roi": [520, 380, 240, 40],
        "expected": "^Resume$",
        "action": "Click",
        "post_delay": 3000
    },
    // Unclaimed rewards: Enter opens the Exploration Reward window, settled like any other.
    "MirrorEntryUnclaimed": {
        "recognition": "OCR",
        "roi": [990, 140, 230, 35],
        "expected": "Exploration Complete",
        "action": "Click",
        "target": [1030, 470, 160, 50],
        "post_delay": 2000
    },
    // Also pops up by itself on the entry page while rewards are pending (captures/253).
    // Settle: goal check, weekly-bonus toggles, Claim or GiveUpRewards (spec 03 section 14).
    "ExplorationReward": {
        "recognition": "OCR",
        "roi": [500, 100, 280, 45],
        "expected": "Exploration Reward",
        "action": "Custom",
        "custom_action": "Settle"
    },
    // After a Claim that spends weekly bonuses (live 2026-10-16): `Rewards Acquired`, then `Pass Level Up`,
    // each over the Exploration Complete summary and closed by its Confirm.
    "ClaimPopup": {
        "recognition": "OCR",
        "roi": [500, 225, 280, 50],
        "expected": "Rewards Acquired|Pass Level Up",
        "action": "Click",
        "target": [575, 455, 130, 35],
        "post_delay": 2000
    },
    "MirrorEnterDialog": {
        "recognition": "OCR",
        "roi": [400, 325, 480, 45],
        "expected": "Will you enter",
        "action": "Custom",
        "custom_action": "TapUntil",
        "post_delay": 0,
        // The entry page behind reads "Before Entry" until the run exists: leaving early plans the run twice.
        "custom_action_param": {
            "target": [650, 465, 220, 40],
            "next": {"roi": [990, 140, 230, 35], "expected": "F\\s*\\d"}
        }
    },
    "LevelWarning": {
        "recognition": "OCR",
        "roi": [400, 230, 480, 90],
        "expected": "recommended level",
        "action": "Custom",
        "custom_action": "TapUntil",
        "post_delay": 0,
        "custom_action_param": {
            "target": [665, 478, 200, 35],
            "next": {"roi": [890, 30, 115, 28], "expected": "Available"},
            "timeout": 4
        }
    },
    "TeamSelect": {
        "recognition": "OCR",
        "roi": [80, 272, 100, 28],
        "expected": "^TEAMS$",
        "action": "Custom",
        "custom_action": "SelectTeam",
        "post_delay": 0
    },
    "StarlightPage": {
        "recognition": "OCR",
        "roi": [890, 30, 115, 28],
        "expected": "Available",
        "action": "Custom",
        "custom_action": "BuyStarlight",
        "post_delay": 0
    },
    "StarlightConfirm": {
        "recognition": "OCR",
        "roi": [480, 210, 320, 35],
        "expected": "Continue with selected effects",
        "action": "Custom",
        "custom_action": "ConfirmStarlight",
        "post_delay": 0
    },
    // The Gift Search page has the same "Selected E.G.O Gift" header; only this page has the Activate Gift Search
    // switch (ON or OFF). Live 2026-10-19 (#166): the search page fading in read as this page before its blue title
    // could be read, and PickStartingGift tapped the search page.
    "StartingGift": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "sub_name": "StartingGiftHeader",
                "roi": [780, 145, 230, 35],
                "expected": "Selected E"
            },
            {
                "recognition": "OCR",
                "sub_name": "StartingGiftSwitch",
                "roi": [1040, 140, 80, 40],
                "expected": "Activate"
            }
        ],
        "action": "Custom",
        "custom_action": "PickStartingGift",
        "post_delay": 0
    },
    // Confirms each window, the next gift's as soon as it is up, until none is left (GiftGet in actions.py).
    "GiftGet": {
        "recognition": "OCR",
        "roi": [520, 160, 240, 40],
        "expected": "Gift GET",
        "action": "Custom",
        "custom_action": "GiftGet",
        "post_delay": 0
    },
    // Selects the team's gifts with owned Starlight, or presses Refuse Gift (spec 03 section 5).
    "GiftSearch": {
        "recognition": "OCR",
        "roi": [140, 30, 220, 35],
        "expected": "Gift Search",
        "action": "Custom",
        "custom_action": "GiftSearch",
        "post_delay": 0
    },
    "GiftSearchForgo": {
        "recognition": "OCR",
        "roi": [480, 330, 320, 35],
        "expected": "Forgo",
        "action": "Custom",
        "custom_action": "TapUntil",
        "post_delay": 0,
        // The dialog reads through its fade-out: leaving early, MirrorHub would confirm it twice.
        "custom_action_param": {
            "target": [665, 478, 200, 35],
            "next": [
                {"roi": [1060, 625, 190, 40], "expected": "NOW LOADING"},
                {"roi": [480, 100, 320, 40], "expected": "THEME ?PACK"}
            ],
            "timeout": 2
        }
    },
    "ThemePack": {
        "recognition": "OCR",
        "roi": [480, 100, 320, 40],
        "expected": "THEME ?PACK",
        "action": "Custom",
        "custom_action": "PickThemePack",
        "post_delay": 0
    },
    // Rewards and events (spec 03 sections 10-12). The bot never cancels a reward or refuses a gift;
    // landing in either dialog anyway, it backs out with Cancel.
    "RewardCardForgo": {
        "recognition": "OCR",
        "roi": [440, 320, 400, 35],
        "expected": "Continue without choosing",
        "action": "Click",
        "target": [455, 448, 165, 37],
        "post_delay": 1500
    },
    // Select with picks left; Confirm would hand out random trials (1.117.0, also after a NORMAL boss).
    "GiftRefuseDialog": {
        "recognition": "OCR",
        "roi": [440, 280, 400, 35],
        "expected": "remaining E.G.O Gift choices",
        "action": "Click",
        "target": [415, 476, 200, 35],
        "post_delay": 1500
    },
    "RewardCard": {
        "recognition": "OCR",
        "roi": [290, 112, 490, 48],
        "expected": "Encounter Reward",
        "action": "Custom",
        "custom_action": "RewardCard"
    },
    // After a fight, an event or a boss (with Mounting Trials); the starting gift page is matched before.
    "GiftChoice": {
        "recognition": "OCR",
        "roi": [870, 560, 160, 40],
        "expected": "Refuse Gift",
        "action": "Custom",
        "custom_action": "PickGift"
    },
    // Shop and Super Shop (spec 03 section 13): the Leave button, also under the shop's own dialogs and pages.
    // Shop heals, then sells, buys, refreshes and fuses in rounds, and leaves.
    "Shop": {
        "recognition": "OCR",
        "roi": [1040, 615, 180, 65],
        "expected": "^Leave$",
        "action": "Custom",
        "custom_action": "Shop"
    },
    // The red button bottom right reads SKIP, Proceed, Continue or Commence, grey while it does nothing.
    "Event": {
        "recognition": "OCR",
        "roi": [1040, 612, 190, 66],
        "expected": "SKIP|Proceed|Continue|Commence",
        "action": "Custom",
        "custom_action": "Event"
    },
    // The map's Dungeon Progress panel (the gear, or the back key on the map): Continue closes it.
    // Over the map, whose icons still show: before MirrorMap.
    "ProgressPanel": {
        "recognition": "OCR",
        "roi": [600, 440, 80, 35],
        "expected": "^Continue$",
        "action": "Click",
        "post_delay": 1500
    },
    // Node selection panel: right-hand Enter. Before MirrorMap: the panel hides part of its icons.
    "MapNodePanel": {
        "recognition": "TemplateMatch",
        "roi": [1030, 495, 210, 95],
        "template": "Map/MapNodePanel.png",
        "threshold": 0.8,
        "action": "Custom",
        "custom_action": "EnterNode"
    },
    // Right-hand icon column (pack detail, team); the Exploring Floor title is often covered.
    // RouteMap picks and enters the next node, or forfeits the run after a wipe's Accept results.
    "MirrorMap": {
        "recognition": "TemplateMatch",
        "roi": [1195, 65, 75, 130],
        "template": "Map/MirrorMap.png",
        "threshold": 0.8,
        "action": "Custom",
        "custom_action": "RouteMap"
    },
    // Battle (spec 03 sections 3, 8, 9). The DEFEAT dialog sits over the battle: first.
    "WipeDialog": {
        "recognition": "OCR",
        "roi": [330, 360, 270, 50],
        "expected": "All participating",
        "action": "Custom",
        "custom_action": "Wipe"
    },
    "Victory": {
        "recognition": "OCR",
        "roi": [420, 280, 440, 140],
        "expected": "VICTORY",
        "action": "Custom",
        "custom_action": "Victory",
        "post_delay": 500
    },
    "Formation": {
        "recognition": "OCR",
        "roi": [1065, 465, 160, 30],
        "expected": "Clear Selection",
        "action": "Custom",
        "custom_action": "Formation"
    },
    // Waiting for input: the Win Rate label, off or on. It moves half a slot (~40 px) right with every
    // extra skill slot: x 984 with 7 slots, ~740 with 1 (a 1-sinner formation, live 2026-10-16).
    "BattleTurn": {
        "recognition": "TemplateMatch",
        "roi": [700, 515, 580, 60],
        "template": [
            "Battle/BattleTurn.png",
            "Battle/BattleTurnPressed.png"
        ],
        "threshold": 0.8,
        "action": "Custom",
        "custom_action": "PlayTurn"
    },
    // A turn playing out: the pause button replaces the top-right controls. PlayTurn holds a finger down
    // through the turn it started (#150); this holds it again after a hold timed out, a recovery or a restart.
    "BattlePause": {
        "recognition": "TemplateMatch",
        "roi": [1130, 5, 100, 75],
        "template": "Battle/BattlePause.png",
        "threshold": 0.8,
        "action": "Custom",
        "custom_action": "HoldTurn",
        "pre_delay": 0,
        "post_delay": 0
    },
    // The START plaque over the disc: every slot has a skill (#145). The agent sets the roi from the disc.
    "BattleStart": {
        "recognition": "TemplateMatch",
        "roi": [870, 480, 140, 60],
        "template": "Battle/BattleStart.png",
        "threshold": 0.5
    },
    // After the floor 5 boss (live 1.117.0); the run's counterpart of DefeatScreen.
    "RunVictory": {
        "recognition": "OCR",
        "roi": [990, 100, 200, 70],
        "expected": "^Victory$",
        "action": "Click",
        "target": [1050, 550, 150, 45],
        "post_delay": 2000
    },
    // After a forfeit (captures/244, 245); Claim Rewards only opens the Exploration Reward window.
    "DefeatScreen": {
        "recognition": "OCR",
        "roi": [1000, 135, 200, 70],
        "expected": "^Defeat$",
        "action": "Click",
        "target": [1052, 548, 150, 40],
        "post_delay": 2000
    },
    "ExplorationComplete": {
        "recognition": "OCR",
        "roi": [130, 90, 210, 70],
        "expected": "Complete",
        "action": "Click",
        "target": [1060, 575, 150, 45],
        "post_delay": 2000
    }
}

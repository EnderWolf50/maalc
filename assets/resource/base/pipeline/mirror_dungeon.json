    "DefeatScreen": {
        "recognition": "TemplateMatch",
        "roi": [995, 130, 210, 80],
        "template": "Screen/Defeat.png",
        "threshold": 0.8,
        "action": "Click",
        "target": [1052, 548, 150, 40],
        "post_delay": 2000

{
    "MirrorDungeon": {
        "next": [
            "MirrorHub"
        ]
    },
    // Dispatch: every screen is one node; [JumpBack] nodes return here to look again.
    // next order is priority: Stuck (the watchdog, which must see every pass), global popups,
    // then dialogs before the page under them.
    // Screens are told apart by templates of their labels (#157): no OCR runs until a template says its screen is up.
    // rate_limit: a pass is ~0.1-0.2 s of work; the default 1000 ms between passes saw every new screen ~0.5 s late.
    "MirrorHub": {
        "timeout": 60000,
        "rate_limit": 300,
        "on_error": [
            "GlobalStuck"
        ],
        "next": [
            "Stuck",
            "NoBatchOCR",
            "[JumpBack]Connecting",
            "[JumpBack]RetryPopup",
            "MaintenanceNotice",
            "[JumpBack]DownloadDialog",
            "[JumpBack]Loading",
            "[JumpBack]ClaimPopup",
            "[JumpBack]ParallelModePrompt",
            "[JumpBack]PopupButton",
            "[JumpBack]ExplorationReward",
            "[JumpBack]RunVictory",
            "[JumpBack]DefeatScreen",
            "[JumpBack]ExplorationComplete",
            "[JumpBack]MirrorEnterDialog",
            "[JumpBack]ResumeDialog",
            "[JumpBack]ParallelModeOn",
            "[JumpBack]MirrorEntryUnclaimed",
            "[JumpBack]MirrorEntryPaused",
            "[JumpBack]MirrorEntryNewRun",
            "[JumpBack]LevelWarning",
            "[JumpBack]TeamSelect",
            "[JumpBack]StarlightConfirm",
            "[JumpBack]StarlightPage",
            "[JumpBack]GiftGet",
            "[JumpBack]GiftSearchForgo",
            "[JumpBack]GiftSearch",
            "[JumpBack]StartingGift",
            "[JumpBack]ThemePack",
            "[JumpBack]RewardCardForgo",
            "[JumpBack]GiftRefuseDialog",
            "[JumpBack]RewardCard",
            "[JumpBack]GiftChoice",
            "[JumpBack]Shop",
            "[JumpBack]Event",
            "[JumpBack]WipeDialog",
            "[JumpBack]Victory",
            "[JumpBack]Formation",
            "[JumpBack]BattleTurn",
            "[JumpBack]BattlePause",
            "[JumpBack]ProgressPanel",
            "[JumpBack]MapNodePanel",
            "[JumpBack]MirrorMap",
            "[JumpBack]GoToMirrorEntry"
        ]
    },
    // Keeps MaaFramework from batching the next list's OCR (#157). Batched, every OCR reads the text boxes of one
    // shared pass and re-reads each box that crosses its roi edge: a battle skill text 1 px into a dialog roi became
    // a 443 x 1 rec padded to 21264 px wide, 7.6 s and the Tasker from 4 to 12 GB for good. The batch takes the
    // model of the list's first OCR and leaves out the others (PipelineTask::try_add_ocr_node), so this node's model,
    // which no other OCR uses, leaves a batch of one: none. Never hits; the 1 x 1 ColorMatch fails before the OCR,
    // so the model is never loaded. tests/test_pipeline.py checks that no next list batches.
    "NoBatchOCR": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "ColorMatch",
                "sub_name": "NoBatchOCRGate",
                "roi": [0, 0, 1, 1],
                "lower": [0, 0, 0],
                "upper": [255, 255, 255],
                "count": 2
            },
            {
                "recognition": "OCR",
                "sub_name": "NoBatchOCRModel",
                "model": "no-batch"
            }
        ]
    },
    // Entry page with Parallel Superposition Mode ON (#94): switched OFF before anything else, the bot never plays
    // past floor 5. Texts: EN_MirrorDungeonUI_5_InfinityFloor ("Parallel Superposition Mode : " + ON / OFF).
    // Its dialogs (Resume, Enter) come first in the hub: the label reads through them.
    "ParallelModeOn": {
        "recognition": "And",
        "all_of": [
            "MirrorEntryPage",
            {
                "recognition": "OCR",
                "sub_name": "ParallelModeOnText",
                "roi": [890, 330, 330, 28],
                "expected": "Superposition.*:\\s*[O0]N\\b"
            }
        ],
        "action": "Custom",
        "custom_action": "ParallelModeOff"
    },
    // The entry page's "Parallel Superposition Mode" label (live EntryNewRun.png, its ON / OFF left out). The entry
    // nodes whose text varies (a floor, ON) or has no capture (Exploration Complete) OCR only once it is up (#157).
    "MirrorEntryPage": {
        "recognition": "TemplateMatch",
        "roi": [885, 325, 340, 38],
        "template": "Screen/ParallelLabel.png",
        "green_mask": true,
        "threshold": 0.8
    },
    // Entry page: branch on the Exploring: field (spec 01, 入口頁的分流).
    "MirrorEntryNewRun": {
        "recognition": "TemplateMatch",
        "roi": [985, 135, 240, 45],
        "template": "Screen/BeforeEntry.png",
        "threshold": 0.8,
        "action": "Custom",
        "custom_action": "PlanRun"
    },
    // A paused run (after To Window, a restart, or by hand): Enter opens the Resume dialog.
    "MirrorEntryPaused": {
        "recognition": "And",
        "all_of": [
            "MirrorEntryPage",
            {
                "recognition": "OCR",
                "sub_name": "MirrorEntryPausedText",
                "roi": [990, 140, 230, 35],
                "expected": "F\\s*\\d"
            }
        ],
        "action": "Custom",
        "custom_action": "TapUntil",
        "custom_action_param": {
            "target": [1030, 470, 160, 50],
            "next": [
                {"roi": [80, 272, 100, 28], "expected": "^TEAMS$"},
                {"roi": [520, 380, 240, 40], "expected": "^Resume$"}
            ],
            "timeout": 4
        }
    },
    // Dungeon Progress with Resume / Halt Exploration / Cancel: always Resume (spec 01 入口頁的分流).
    "ResumeDialog": {
        "recognition": "TemplateMatch",
        "roi": [515, 375, 250, 50],
        "template": "Screen/Resume.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 3000
    },
    // Unclaimed rewards: Enter opens the Exploration Reward window, settled like any other.
    "MirrorEntryUnclaimed": {
        "recognition": "And",
        "all_of": [
            "MirrorEntryPage",
            {
                "recognition": "OCR",
                "sub_name": "MirrorEntryUnclaimedText",
                "roi": [990, 140, 230, 35],
                "expected": "Exploration Complete"
            }
        ],
        "action": "Click",
        "target": [1030, 470, 160, 50],
        "post_delay": 2000
    },
    // Also pops up by itself on the entry page while rewards are pending (captures/253).
    // Settle: goal check, weekly-bonus toggles, Claim or GiveUpRewards (spec 03 section 14).
    "ExplorationReward": {
        "recognition": "TemplateMatch",
        "roi": [495, 95, 290, 55],
        "template": "Screen/ExplorationReward.png",
        "threshold": 0.8,
        "action": "Custom",
        "custom_action": "Settle"
    },
    // After a Claim that spends weekly bonuses (live 2026-10-16): `Rewards Acquired`, then `Pass Level Up`,
    // each over the Exploration Complete summary and closed by its Confirm.
    "ClaimPopup": {
        "recognition": "TemplateMatch",
        "roi": [495, 220, 290, 60],
        "template": [
            "Screen/RewardsAcquired.png",
            "Screen/PassLevelUp.png"
        ],
        "threshold": 0.8,
        "action": "Click",
        "target": [575, 455, 130, 35],
        "post_delay": 2000
    },
    "MirrorEnterDialog": {
        "recognition": "TemplateMatch",
        "roi": [395, 320, 490, 55],
        "template": "Screen/WillYouEnter.png",
        "threshold": 0.8,
        "action": "Custom",
        "custom_action": "TapUntil",
        // The entry page behind reads "Before Entry" until the run exists: leaving early plans the run twice.
        "custom_action_param": {
            "target": [650, 465, 220, 40],
            "next": {"roi": [990, 140, 230, 35], "expected": "F\\s*\\d"}
        }
    },
    "LevelWarning": {
        "recognition": "TemplateMatch",
        "roi": [395, 225, 490, 100],
        "template": "Screen/RecommendedLevel.png",
        "threshold": 0.8,
        "action": "Custom",
        "custom_action": "TapUntil",
        "custom_action_param": {
            "target": [665, 478, 200, 35],
            "next": {"roi": [890, 30, 115, 28], "expected": "Available"},
            "timeout": 4
        }
    },
    "TeamSelect": {
        "recognition": "TemplateMatch",
        "roi": [75, 267, 110, 38],

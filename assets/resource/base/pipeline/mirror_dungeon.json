    "GiftRefuseDialog": {
        "recognition": "TemplateMatch",
        "roi": [435, 275, 410, 45],
        "template": "Screen/RemainingChoices.png",
        "threshold": 0.8,
        "action": "Click",
        "target": [415, 476, 200, 35],
        "post_delay": 1500
    },
    "RewardCard": {
        "recognition": "TemplateMatch",
        "roi": [285, 107, 500, 58],
        "template": "Screen/EncounterReward.png",
        "green_mask": true,
        "threshold": 0.8,
        "action": "Custom",

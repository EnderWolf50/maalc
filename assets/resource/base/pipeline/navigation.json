{
    // From outside Mirror Dungeons to its entry page (spec 01, 導航到鏡牢入口頁).
    // Kept out of MirrorHub: the hub falls back to it last, recovery reuses it.
    "GoToMirrorEntry": {
        "recognition": "Or",
        "any_of": [
            "NavDrive",
            "NavMainTabs",
            "NavTitle"
        ],
        "next": [
            "NavDrive",
            "NavMainTabs",
            "NavTitle"
        ]
    },
    "NavTitle": {
        "recognition": "TemplateMatch",
        "roi": [20, 620, 200, 70],
        "template": "Navigation/NavTitle.png",
        "threshold": 0.8,
        "action": "Click",
        "target": [540, 300, 200, 120],
        "post_delay": 3000
    },
    // Bottom tab bar; Drive looks different once it is the open tab.
    "NavMainTabs": {
        "recognition": "TemplateMatch",
        "roi": [930, 600, 110, 80],
        "template": "Navigation/NavMainTabs.png",
        "threshold": 0.9,
        "action": "Click",
        "post_delay": 2000
    },
    "NavDrive": {
        "recognition": "TemplateMatch",
        "roi": [340, 240, 240, 140],
        "template": "Navigation/NavDrive.png",
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 3000
    }
}

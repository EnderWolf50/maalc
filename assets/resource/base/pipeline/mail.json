{
    // ClaimMail (#372): open the Mailbox, press Claim All, end done. The global Mailbox (popups.json) stays as it was:
    // it only presses Close; here the task presses Claim All because the player ticked it.
    // Spec 01 (daily tasks): TaskStart, GoHome run by GoHomeRun (MailHome), the hub; the last step runs GoHome again
    // (MailDone),
    // and the global Mailbox (GoHome's HomeText) closes the box with its own Close.
    "ClaimMail": {
        "action": "Custom",
        "custom_action": "TaskStart",
        "next": [
            "MailHome"
        ]
    },
    "MailHome": {
        "action": "Custom",
        "custom_action": "GoHomeRun",
        "next": [
            "ClaimMailHub"
        ]
    },
    "ClaimMailHub": {
        "timeout": 60000,
        "rate_limit": 300,
        "on_error": [
            "ClaimMailLost"
        ],
        "next": [
            "TaskDone",
            "[JumpBack]MailText",
            "[JumpBack]HomeText",
            "[JumpBack]MailOpen"
        ]
    },
    "ClaimMailLost": {
        "action": "Custom",
        "custom_action": "StopTask",
        "custom_action_param": "the mail was not claimed"
    },
    // The open Mailbox and what can be over it, read in one OCR pass (hub_text.py, #157). The server's popups first: the
    // box still reads under them (ServerErrorRetry.png). Then the empty box, ahead of the one-button popup: the game's
    // "No mail available to claim" may be such a popup over the box, and it says the task is done. Then a one-button
    // popup, then Claim All. Not HomeText's Mailbox: the box's own Close is not what ClaimMail wants.
    "MailText": {
        "recognition": "Custom",
        "custom_recognition": "HubText",
        "custom_recognition_param": {
            "base": "ServerPopups",
            "entries": [
                "MailEmpty",
                "PopupButton",
                "MailClaimAll"
            ],
            "tail": []
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 300,
        "timeout": 0,
        "on_error": [
            "MailTextLost"
        ]
    },
    "MailTextLost": {
        "pre_delay": 0,
        "post_delay": 0
    },
    // Nothing to claim: "No mail in storage." on the open box (tests/screens/MailboxEmpty.png), or the game's
    // "No mail available to claim with 'Claim All'" (not captured). Done, a success, saying whether Claim All was pressed
    // (MailDone); GoHome closes the box.
    // MailEmptyText's roi is wide to take both: TODO narrow it once the second message is captured (review T5).
    "MailEmpty": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "sub_name": "MailEmptyTitle",
                "roi": [500, 100, 280, 45],
                "expected": "^Mailbox$"
            },
            {
                "recognition": "OCR",
                "sub_name": "MailEmptyText",
                "roi": [200, 250, 880, 200],
                "expected": "No mail (in storage|available)"
            }
        ],
        "action": "Custom",
        "custom_action": "MailDone",
        "post_delay": 500
    },
    // Claim All beside the box's Close (Mailbox.png). max_hit: a confirm or result window over the box can leave the
    // button reading; three presses is far more than one claim needs.
    "MailClaimAll": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "sub_name": "MailClaimTitle",
                "roi": [500, 100, 280, 45],
                "expected": "^Mailbox$"
            },
            {
                "recognition": "OCR",
                "sub_name": "MailClaimButton",
                "roi": [880, 530, 180, 45],
                "expected": "^Claim All$"
            }
        ],
        "box_index": 1,
        "action": "Click",
        "post_delay": 2500,
        "max_hit": 3
    },
    // The envelope at the top right of the main window (HomeReached).
    "MailOpen": {
        "recognition": "And",
        "all_of": [
            "HomeReached"
        ],
        "action": "Click",
        "target": [1085, 95, 70, 60],
        "post_delay": 2000,
        "max_hit": 2
    }
}

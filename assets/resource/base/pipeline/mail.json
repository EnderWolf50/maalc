{
    // ClaimMail (#372): open the Mailbox, press Claim All, end done. The global Mailbox (popups.json) stays as it was:
    // it only presses Close; here the task presses Claim All because the player ticked it.
    // Spec 01 (daily tasks): TaskStart, GoHome run by GoHomeRun, the hub; the last step runs GoHome again (MailFinish),
    // and the global Mailbox (GoHome's HomeText) closes the box with its own Close.
    "ClaimMail": {
        "action": "Custom",
        "custom_action": "TaskStart",
        "next": [
            "MailStart"
        ]
    },
    "MailStart": {
        "action": "Custom",
        "custom_action": "GoHomeRun",
        "next": [
            "ClaimMailHub"
        ]
    },
    "ClaimMailHub": {
        "timeout": 60000,
        "rate_limit": 300,
        "on_error": [
            "ClaimMailLost"
        ],
        "next": [
            "TaskDone",
            "[JumpBack]MailPopups",
            "[JumpBack]MailText",
            "[JumpBack]HomeText",
            "[JumpBack]MailOpen"
        ]
    },
    "ClaimMailLost": {
        "action": "Custom",
        "custom_action": "StopTask",
        "custom_action_param": "the mail was not claimed"
    },
    // HomeText's popups but the Mailbox (and the notices and the menu): a popup over the open box comes first, the box
    // still reads under it (ServerErrorRetry.png), and the box's own Close is not what ClaimMail wants.
    "MailPopups": {
        "recognition": "Custom",
        "custom_recognition": "MailPopups",
        "custom_recognition_param": {
            "entries": [
                "RetryPopup",
                "MaintenanceNotice",
                "ClientOutdated",
                "UpdateDialog",
                "UserAgreement",
                "DownloadDialog",
                "Downloading",
                "Loading",
                "PopupButton"
            ],
            "tail": []
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 300,
        "timeout": 0,
        "on_error": [
            "MailTextLost"
        ]
    },
    // The Mailbox's own two screens, read in one OCR pass (hub_text.py, #157): empty first, then Claim All.
    "MailText": {
        "recognition": "Custom",
        "custom_recognition": "MailText",
        "custom_recognition_param": {
            "entries": [
                "MailEmpty",
                "MailClaimAll"
            ],
            "tail": []
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 300,
        "timeout": 0,
        "on_error": [
            "MailTextLost"
        ]
    },
    "MailTextLost": {
        "pre_delay": 0,
        "post_delay": 0
    },
    // Nothing to claim: "No mail in storage." on the open box (tests/screens/MailboxEmpty.png), or the game's
    // "No mail available to claim with 'Claim All'" (not captured). Done, a success; GoHome closes the box.
    "MailEmpty": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "sub_name": "MailEmptyTitle",
                "roi": [500, 100, 280, 45],
                "expected": "^Mailbox$"
            },
            {
                "recognition": "OCR",
                "sub_name": "MailEmptyText",
                "roi": [200, 250, 880, 200],
                "expected": "No mail (in storage|available)"
            }
        ],
        "action": "Custom",
        "custom_action": "MailFinish",
        "post_delay": 500
    },
    // Claim All beside the box's Close (Mailbox.png). max_hit: a confirm or result window over the box can leave the
    // button reading; three presses is far more than one claim needs.
    "MailClaimAll": {
        "recognition": "And",
        "all_of": [
            {
                "recognition": "OCR",
                "sub_name": "MailClaimTitle",
                "roi": [500, 100, 280, 45],
                "expected": "^Mailbox$"
            },
            {
                "recognition": "OCR",
                "sub_name": "MailClaimButton",
                "roi": [880, 530, 180, 45],
                "expected": "^Claim All$"
            }
        ],
        "box_index": 1,
        "action": "Click",
        "post_delay": 2500,
        "max_hit": 3
    },
    // The envelope at the top right of the main window (Window tab lit, as HomeReached).
    "MailOpen": {
        "recognition": "TemplateMatch",
        "roi": [770, 598, 110, 84],
        "template": "Navigation/NavWindowLit.png",
        "threshold": 0.9,
        "action": "Click",
        "target": [1085, 95, 70, 60],
        "post_delay": 2000,
        "max_hit": 2
    }
}
